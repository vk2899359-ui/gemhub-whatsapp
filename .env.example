# ─────────────────────────────────────────────────────────────
# GemHub WhatsApp Automation — environment variables
# Copy to `.env` for local dev, and add all of these in the
# Vercel project (Settings → Environment Variables) for prod.
# NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────

# Public URL of THIS deployment (no trailing slash). Used to
# register Shopify webhooks and build callback addresses.
# e.g. https://gemhub-whatsapp.vercel.app
PUBLIC_BASE_URL=

# ── Shopify (Dev Dashboard app, client_credentials grant) ────
SHOPIFY_STORE=vbvidr-u9.myshopify.com
# App Client ID from the Shopify Dev Dashboard (Settings → Credentials)
SHOPIFY_API_KEY=
# App Client secret (shpss_...). Doubles as the webhook HMAC signing secret.
SHOPIFY_API_SECRET=
# Optional: a static Admin API token (shpat_...). If set, it overrides the
# client_credentials flow. Leave empty for Dev Dashboard apps.
SHOPIFY_TOKEN=
# Admin API version (leave default unless you know why)
SHOPIFY_API_VERSION=2024-10

# ── WhatsApp Cloud API (Meta) ────────────────────────────────
WABA_ID=1747154966614614
PHONE_NUMBER_ID=1186838137853897
# Permanent system-user token with whatsapp_business_messaging
META_TOKEN=
# Token you invent; must match the value entered in Meta webhook config
VERIFY_TOKEN=gemhub2026
# Meta Graph API version
GRAPH_API_VERSION=v21.0
# (Optional) Meta App Secret — if set, inbound webhook payloads are
# verified against the X-Hub-Signature-256 header.
META_APP_SECRET=

# ── Anthropic (Claude) ───────────────────────────────────────
ANTHROPIC_API_KEY=
# Model used for AI replies. Override here if needed.
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Sales consultant / storefront presentation ───────────────
# Currency symbol shown to customers on prices.
STORE_CURRENCY=₹
# Native WhatsApp catalog product/product_list messages. When the Shopify
# catalogue is connected to the WABA and this is "true", the bot sends
# interactive product messages; otherwise it sends real image messages.
WHATSAPP_USE_CATALOG=false
# Optional explicit catalog id; auto-detected from the WABA when unset.
WHATSAPP_CATALOG_ID=
# Showroom map pin coordinates (Sector 45, Gurugram) for location messages.
SHOWROOM_LAT=28.4595
SHOWROOM_LNG=77.0724

# ── Human handover (sales agent) ──────────────────────────────
# Who the bot hands customers off to. Defaults already match the current
# agent, so these are optional — set them if the agent ever changes.
SALES_AGENT_NAME=Keshav
SALES_AGENT_PHONE=+91 85957 72402

# ── Upstash Redis (REST) ─────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Security ─────────────────────────────────────────────────
# Secret required as ?secret=... to run /api/register-webhooks
REGISTER_SECRET=
# Secret Vercel Cron sends as `Authorization: Bearer <CRON_SECRET>`.
# Set the SAME value in Vercel env so the cron endpoint can authenticate.
CRON_SECRET=

# ── CRM dashboard (/dashboard) ────────────────────────────────
# Shared password gating the dashboard — no user accounts. Pick a strong,
# unique value; it also signs the session cookie (see lib/dashboardAuth.js).
DASHBOARD_PASSWORD=

# ── Bulk campaigns (/campaigns) ───────────────────────────────
# Auth for the self-chaining tick endpoints (/api/campaigns/*) — shared
# between self-chain calls, the dashboard's server-side triggers, and (if
# you choose to use one) an external cron pinger. Pick a strong random value.
CAMPAIGN_SECRET=
# Default messages/second when a campaign doesn't set its own — deliberately
# conservative. Override per-campaign in the builder UI.
CAMPAIGN_DEFAULT_THROTTLE_PER_SEC=1
# Default days before the SAME phone can receive another marketing campaign,
# enforced globally across all campaigns.
CAMPAIGN_DEFAULT_COOLDOWN_DAYS=7
# Hard global cap on campaign sends per UTC day, across every campaign combined.
CAMPAIGN_DAILY_CAP=1000
# Campaigns with more recipients than this MUST go through test-send +
# explicit approval before they can start running.
CAMPAIGN_TEST_SEND_REQUIRED_OVER=100
# Per-tick processing budget in ms — stay well under Vercel's 60s function
# timeout (Hobby). Leave default unless you know why.
CAMPAIGN_TICK_BUDGET_MS=45000
# Owner/ops number that receives the mandatory test send and safety alerts
# (quality-rating drops, etc). Defaults to the number used during setup.
CAMPAIGN_ALERT_PHONE=+91 7906081795

# ── Zoho CRM lead sync (optional) ─────────────────────────────
# Leave all three empty to use CSV import only (fully functional without
# these). Set all three to enable the dashboard's "Sync from Zoho" button.
# See README "Zoho CRM live sync setup" for how to generate a Self Client
# refresh token (a ~5 minute one-time step in the Zoho API Console).
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Zoho data-center base URLs — defaults assume an India (.in) account.
# Change both if your Zoho org is on a different data center (.com/.eu/etc).
ZOHO_ACCOUNTS_BASE=https://accounts.zoho.in
ZOHO_API_BASE=https://www.zohoapis.in
