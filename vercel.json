{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60,
      "memory": 256
    }
  },
  "crons": [
    {
      "path": "/api/cron/abandoned-cart",
      "schedule": "0 5 * * *"
    }
  ],
  "rewrites": [
    { "source": "/dashboard", "destination": "/api/dashboard" }
  ]
}
